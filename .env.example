# Aucune cle n'est necessaire pour la phase 1 (generation et controle du jeu de
# donnees) ni pour `make test` : les tests tournent sur un client LLM simule.

# Phase 2 et suivantes.
ANTHROPIC_API_KEY=sk-ant-...

# Modele utilise par les specialistes, l'arbitre et la baseline.
# Le meme pour tous les bras : la comparaison n'a de sens qu'a modele constant.
COUNCIL_MODEL=claude-sonnet-5

# Plafond DUR de depense pour un run. Depassement => arret propre, resultats
# partiels ecrits, rapport marque PARTIEL. Ce n'est pas un objectif, c'est un
# disjoncteur : le regler a ~1,5x l'estimation du --dry-run.
COUNCIL_BUDGET_USD=25.0

# Cache disque des reponses LLM. Le desactiver (0) pour mesurer la variance.
COUNCIL_CACHE_ENABLED=1
